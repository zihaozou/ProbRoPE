{
  "task": "sft",
  "seed": 42,
  "model_paths": ["models/dfuse_rgb_base.safetensors", "models/Wan2.1_VAE.safetensors", "models/models_t5_umt5-xxl-enc-bf16.safetensors"],
  "tokenizer_path": "models/google/umt5-xxl",
  "trainable_models": "dit.blocks.*.fusion_attn;dit.blocks.*.cam_encoder;dit.blocks.*.projector;dit.blocks.*.modulation_fuse;dit.blocks.*.ffn.ffn_list.1",
  "dataset_base_path": "data/train",
  "sampling_mode": "multi_view",
  "cam_embed_mode": "plucker",
  "modulation_type": "learned",
  "fixed_cameras_only": true,
  "dataset_repeat": "1",
  "dataset_num_workers": 4,
  "pin_memory": true,
  "num_frames_list": [9, 17, 25, 33, 41, 49],
  "resize_scales": "1.0",
  "source_modalities": ["rgb", "events"],
  "target_modalities": ["rgb"],
  "enable_frame_rate_reduction": "true,false",
  "enable_source_noise": true,
  "source_noise_timestep_range": [699, 999],
  "p_text_dropout": 0.1,
  "p_modality_drop": "0.1,0.1",
  "learning_rate": 0.0001,
  "num_epochs": 1000,
  "batch_size": 4,
  "gradient_accumulation_steps": 1,
  "use_gradient_checkpointing": true,
  "output_path": "outputs/dfuse",
  "save_epochs": 1,
  "keep_n_checkpoints": 1,
  "use_wandb": false
}
